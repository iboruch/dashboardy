# Backend Configuration
# Safe local defaults. Copy this file to backend/.env before running locally.

# FastAPI Settings
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Frontend URL for CORS
FRONTEND_URL=http://localhost:4200

# JWT Settings
JWT_SECRET=change-me-for-local-development
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Database
DATABASE_URL=sqlite:///./dashboardy.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/dashboardy

# OAuth provider credentials
# Leave values empty to run Dashboardy in demo mode. Real provider calls require
# credentials created in each provider console and matching callback URLs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Linear currently uses a personal API key in the backend route examples.
LINEAR_API_KEY=

# Optional: Redis for caching
REDIS_URL=redis://localhost:6379/0
